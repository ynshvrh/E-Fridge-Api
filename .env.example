PORT=8080
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/e_fridge?sslmode=disable
JWT_SECRET=super-secret-e-fridge-development-key-change-in-production-12345
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
APP_ENV=development

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# Email Provider Configuration ('resend' or 'smtp')
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=E-Fridge <onboarding@resend.dev>

# SMTP Configuration (optional, if EMAIL_PROVIDER=smtp)
